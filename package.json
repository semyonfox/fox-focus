{
  "name": "fox-focus",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.ts",
    "test": "node --test server/*.test.ts",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "bundle": "tsc --noEmit && vite build --mode standalone && node scripts/bundle-single-html.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7",
    "lucide-react": "1.44.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
